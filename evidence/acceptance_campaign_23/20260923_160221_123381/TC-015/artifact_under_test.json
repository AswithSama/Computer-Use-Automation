{
  "schema_version": "1.0",
  "capability_id": "get_member_email",
  "description": "Retrieve the email address (member_email) for a specified member given their member_id.",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Member ID entered into the Member ID textbox to retrieve the member's email address."
    }
  ],
  "actions": [
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "01 Member Search Locate a member by member ID and review linked accounts."
      },
      "value": null,
      "url": null
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Member ID"
      },
      "value": "{{member_id}}",
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search"
      },
      "value": null,
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "Open Member"
      },
      "value": null,
      "url": null
    }
  ],
  "checkpoints": [
    {
      "after_action": 1,
      "url_pattern": "/__acceptance_impossible_checkpoint__",
      "required_text": []
    },
    {
      "after_action": 3,
      "url_pattern": "/members?member_id={{member_id}}",
      "required_text": []
    },
    {
      "after_action": 4,
      "url_pattern": "/members/{{member_id}}",
      "required_text": []
    }
  ],
  "outputs": [
    {
      "name": "member_email",
      "type": "string",
      "binding": {
        "kind": "table",
        "row_match": {
          "column": "Field",
          "value": "Email"
        },
        "value_column": "Value"
      }
    }
  ]
}
