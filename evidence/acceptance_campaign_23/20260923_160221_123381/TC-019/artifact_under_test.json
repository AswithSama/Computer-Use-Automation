{
  "schema_version": "1.0",
  "capability_id": "get_current_checking_balance",
  "description": "Retrieve the current available balance of a member's checking account given a member_id.",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "The member identifier entered into the Member ID field."
    }
  ],
  "actions": [
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "01 Member Search Locate a member by member ID and review linked accounts."
      },
      "value": null,
      "url": null
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Member ID"
      },
      "value": "{{member_id}}",
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search"
      },
      "value": null,
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "Open Member"
      },
      "value": null,
      "url": null
    }
  ],
  "checkpoints": [
    {
      "after_action": 1,
      "url_pattern": "/members",
      "required_text": []
    },
    {
      "after_action": 3,
      "url_pattern": "/members?member_id={{member_id}}",
      "required_text": []
    },
    {
      "after_action": 4,
      "url_pattern": "/members/{{member_id}}",
      "required_text": []
    }
  ],
  "outputs": [
    {
      "name": "checking_balance",
      "type": "currency",
      "binding": {
        "kind": "table",
        "row_match": {
          "column": "Type",
          "value": "Checking"
        },
        "value_column": "Current Balance"
      }
    }
  ]
}
