{
  "schema_version": "1.0",
  "capability_id": "get_savings_balance",
  "description": "Retrieve the current savings balance (currency) for a specified member.",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Member ID used to look up the member's savings balance."
    }
  ],
  "actions": [
    {
      "action": "navigate",
      "target": null,
      "value": null,
      "url": "https://example.com"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Member ID"
      },
      "value": "{{member_id}}",
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search"
      },
      "value": null,
      "url": null
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "Open Member"
      },
      "value": null,
      "url": null
    }
  ],
  "checkpoints": [
    {
      "after_action": 1,
      "url_pattern": "/members",
      "required_text": []
    },
    {
      "after_action": 3,
      "url_pattern": "/members?member_id={{member_id}}",
      "required_text": []
    },
    {
      "after_action": 4,
      "url_pattern": "/members/{{member_id}}",
      "required_text": []
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "currency",
      "binding": {
        "kind": "table",
        "row_match": {
          "column": "Type",
          "value": "Savings"
        },
        "value_column": "Current Balance"
      }
    }
  ]
}
